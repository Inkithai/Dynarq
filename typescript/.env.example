# Copy to .env and fill in, or set these in the hosting dashboard.
# The app runs with none of them set: these only change the defaults.

# Port the page listens on.
PORT=8000

# Folder that holds invoices.json and sent.json.
# Relative paths are resolved from where the app is started.
DATA_DIR=../data

# The date the rules run against, as YYYY-MM-DD.
# Leave it empty to use the real date on the machine.
TODAY=
